# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links. Leave empty to show them as inactive in the footer.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# Optional email shown on the contact page.
NEXT_PUBLIC_DEMO_EMAIL=

# Form submission: mock (default) | custom-api | hubspot
# NEVER put private API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_FORM_PROVIDER=mock
# Used when NEXT_PUBLIC_FORM_PROVIDER=custom-api (defaults to /api/lead)
NEXT_PUBLIC_FORM_ENDPOINT=
# Used when NEXT_PUBLIC_FORM_PROVIDER=hubspot (public IDs, not secrets)
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID=
